generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  TRASHED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  IN_PROGRESS
}

enum VideoType {
  YOUTUBE
  YOUTUBE_SHORT
  TIKTOK
  TWITTER
  VIMEO
  ODYSEE
  GENERIC
}

enum CourseStatus {
  COMING_SOON
  AVAILABLE
  IN_PROGRESS
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExperimentStatus {
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  ABANDONED
}

/// Tipo LEGADO de un recurso (columna `resources.type`).
/// La fuente de verdad es `Resource.resourceTypeId` (tabla `resource_types`).
/// Se conserva como valor denormalizado/por compatibilidad de los recursos
/// antiguos; el @@map mantiene el nombre del tipo en la base de datos.
enum LegacyResourceType {
  SCRIPT
  TEMPLATE
  DOCKER
  CHECKLIST
  GUIDE
  DATASET
  OTHER

  @@map("ResourceType")
}

enum TimelineEventType {
  EDUCATION
  WORK
  PROJECT
  ACHIEVEMENT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  avatar       String?
  bio          String?
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  posts        Post[]
  comments     Comment[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  action String
  resource String
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([action, resource, roleId])
  @@map("permissions")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverImage  String?    @map("cover_image")
  videoUrl    String?    @map("video_url")
  videoType   VideoType? @map("video_type")
  externalLinkLabel String? @map("external_link_label")
  externalLinkUrl   String? @map("external_link_url")
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?  @map("published_at")
  readingTime Int        @default(0) @map("reading_time")
  authorId    String     @map("author_id")
  author      User       @relation(fields: [authorId], references: [id])

  // Taxonomía de dos niveles, EDITABLE desde el CMS.
  // `mainCategoryId` es obligatorio y apunta a `main_categories` (se crean y
  // editan desde /admin/categorias). `subCategoryId` es opcional; que la
  // subcategoría pertenezca a la categoría principal lo garantiza un trigger en
  // Postgres (ver migración) además de la validación en el service.
  mainCategoryId String       @map("main_category_id")
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  subCategoryId  String?      @map("sub_category_id")
  subCategory    Subcategory? @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)

  tags        PostTag[]
  comments    Comment[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([mainCategoryId, subCategoryId])
  /// La BD de producción ya tenía `posts_featured_idx` (creado a mano en
  /// 202608230200) y el schema no lo declaraba: se declara aquí para que
  /// `prisma migrate diff` no reporte drift.
  @@index([featured])
  @@map("posts")
}

/// Categoría principal (nivel 1). Es una TABLA y no un enum porque se crea y edita
/// desde el CMS: los valores no pueden ser fijos. `color` es la clave de la paleta
/// del frontend (emerald, cyan, amber, ...) elegida por el usuario al crearla.
model MainCategory {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  position      Int           @default(0)
  color         String        @default("emerald")
  posts         Post[]
  subcategories Subcategory[]

  @@index([position])
  @@map("main_categories")
}

/// Subcategoría de segundo nivel. Pertenece SIEMPRE a una categoría principal
/// concreta: (mainCategoryId, slug) es único. El trigger `enforce_post_subcategory_parent`
/// impide asignarla a un post cuya categoría principal sea otra.
model Subcategory {
  id             String       @id @default(cuid())
  slug           String
  name           String
  description    String?
  position       Int          @default(0)
  mainCategoryId String       @map("main_category_id")
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  posts          Post[]

  @@unique([mainCategoryId, slug])
  @@index([mainCategoryId, position])
  @@index([slug])
  @@map("subcategories")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

/// Clasificación de proyectos (editable desde /admin/projects/clasificacion).
/// Antes eran valores fijos en el formulario; ahora es una tabla como
/// `MainCategory`, para poder crear/renombrar/reordenar sin tocar código.
model ProjectCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  /** Orden: menor número = primero (múltiplos de 10 para insertar entre dos). */
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects    Project[]

  @@index([position])
  @@map("project_categories")
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description       String
    longDescription   String?       @map("long_description")
    /** Cuerpo del proyecto en Markdown (mismo formato que los artículos). */
    content           String?
    technologies      String[]
  /** Nombre de la clasificación (denormalizado desde `projectCategory`). */
  category          String?
  /** Clasificación editable del proyecto. */
  projectCategoryId String?       @map("project_category_id")
  /** Orden manual: menor número = primero en el sitio público. */
  position          Int           @default(0)
  tags              String[]      @default([])
  projectYear       Int?          @map("project_year")
  repository        String?
  demo              String?
  documentation     String?
  status            ProjectStatus @default(IN_PROGRESS)
  featured          Boolean       @default(false)
  coverImage        String?       @map("cover_image")
  problem           String?
  solution          String?
  role              String?
  architecture      String?
  architectureImage String?       @map("architecture_image")
  technicalDecisions Json         @default("[]") @map("technical_decisions")
  challenges        Json         @default("[]")
  results           String?
  learnings         String?
  gallery           String[]      @default([])
  publishedAt       DateTime?     @map("published_at")
  /// Tiempo de lectura estimado, en minutos. Opcional: si está vacío la web lo calcula.
  readingTime       Int?          @map("reading_time")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  projectCategory ProjectCategory? @relation(fields: [projectCategoryId], references: [id], onDelete: SetNull)

  @@index([position])
  @@index([projectCategoryId])
  @@map("projects")
}

model Video {
  id          String    @id @default(cuid())
  title       String
  url         String
  videoType   VideoType @default(YOUTUBE)
  thumbnail   String?
  description String?
  publishedAt DateTime  @default(now()) @map("published_at")
  isShort     Boolean   @default(false) @map("is_short")
  featured    Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([featured, position])
  @@map("videos")
}

model Course {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String
  subtitle     String?
  level        CourseDifficulty @default(BEGINNER)
  duration     String
  lessonsCount Int              @default(0) @map("lessons_count")
  status       CourseStatus     @default(COMING_SOON)
  coverImage   String?          @map("cover_image")
  position     Int              @default(0)
  /** Bullets de "lo que aprenderás" (uno por línea en el CMS). */
  learningPoints String[]       @default([]) @map("learning_points")
  /** Requisitos previos del alumno. */
  requirements   String[]       @default([]) @map("requirements")
  /** A quién va dirigido el curso. */
  targetAudience String?        @map("target_audience")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  modules      CourseModule[]

  @@index([status, position])
  @@map("courses")
}

enum LessonType {
  VIDEO
  ARTICLE
  PRACTICE
  QUIZ
}

/** Módulo de un curso: agrupa clases. */
model CourseModule {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, position])
  @@map("course_modules")
}

/** Clase de un módulo: video (estilo Platzi) + contenido escrito. */
model Lesson {
  id          String     @id @default(cuid())
  moduleId    String     @map("module_id")
  title       String
  slug        String
  description String?
  type        LessonType @default(VIDEO)
  videoUrl    String?    @map("video_url")
  videoType   VideoType  @default(YOUTUBE) @map("video_type")
  /** Contenido en Markdown que acompaña al video. */
  content     String?
  /** Duración en minutos. */
  duration    Int        @default(0)
  /** Recursos de la clase: [{ label, url }] */
  resources   Json?
  isFree      Boolean    @default(true) @map("is_free")
  published   Boolean    @default(true)
  position    Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

model LabExperiment {
  id              String           @id @default(cuid())
  title           String           @default("")
  slug            String           @unique
  description     String
  objective       String?
  hypothesis      String?
  environment     String?
  procedure       String?
  status          ExperimentStatus @default(IN_PROGRESS)
  result          String?
  conclusion      String?
  stack           String[]
  tags            String[]         @default([])
  coverImage      String?          @map("cover_image")
  gallery         String[]         @default([])
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  relatedPostId   String?          @map("related_post_id")
  relatedProjectId String?         @map("related_project_id")
  /** Cuerpo del experimento en Markdown (editor enriquecido, mismo formato que los artículos). */
  content         String           @default("")
  /** Video largo (10-20 min) en YouTube que documenta el experimento. */
  videoUrl        String?          @map("video_url")
  /** Duración del video en minutos. */
  videoDuration   Int?             @map("video_duration")
  /** Capítulos del video: [{ time: "00:00", title: "..." }] (para la descripción de YouTube). */
  chapters        Json             @default("[]")
  /** Hitos interactivos de la ficha de laboratorio (timeline): [{ id, title, summary, kind, content }]. */
  milestones      Json             @default("[]")
  /** Borrador/Publicado: solo los publicados aparecen en /lab. */
  published       Boolean          @default(false)
  /** Minutos de lectura estimados del cuerpo. */
  readingTime     Int              @default(0) @map("reading_time")
  // Legacy columns are retained during the data migration and are no longer exposed by the API.
  name            String
  icon            String?
  url             String?
  position        Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([published, startedAt])
  @@map("lab_services")
}

/** Recurso descargable de la sección Recursos (scripts, plantillas, guías...). */
model Resource {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  /** @deprecated tipo legado (enum fijo): la fuente de verdad es `resourceTypeId`. */
  type          LegacyResourceType @default(OTHER)
  /** Tipo editable (tabla `resource_types`, gestionada en el panel). */
  resourceTypeId String?           @map("resource_type_id")
  resourceType   ResourceType?     @relation(fields: [resourceTypeId], references: [id], onDelete: SetNull)
  /** URL pública del archivo subido o del enlace externo. */
  fileUrl     String?      @map("file_url")
  /** Nombre original del archivo (para la descarga). */
  fileName    String?      @map("file_name")
  /** Tamaño en bytes. */
  fileSize    Int?         @map("file_size")
  /** Versión del recurso (opcional). */
  version     String?
  tags        String[]
  published   Boolean      @default(true)
  featured    Boolean      @default(false)
  position    Int          @default(0)
  /** Contador de descargas (se incrementa en el endpoint público). */
  downloads   Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([published, position])
  @@index([resourceTypeId])
  @@map("resources")
}

/// Tipos de recurso EDITABLES del panel (Recursos › Tipos).
/// Antes eran un enum fijo en el formulario; ahora son filas de tabla, igual que
/// `project_categories` o las categorías del blog.
model ResourceType {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  /// Clave del icono del listado público (ver `RESOURCE_ICONS` en la web).
  icon        String   @default("file")
  /** Orden: menor número = primero (múltiplos de 10 para insertar entre dos). */
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  resources   Resource[]

  @@index([position])
  @@map("resource_types")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String   @map("mime_type")
  size      Int
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?  @map("author_id")
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model TimelineEvent {
  id          String           @id @default(cuid())
  year        String
  title       String
  description String
  type        TimelineEventType @default(PROJECT)
  position    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([position, createdAt])
  @@map("timeline_events")
}

/// Categoría del grid de tecnologías del inicio (FRONTEND, BACKEND, DEVOPS, ...).
/// Se crea y edita desde el CMS; los ítems cuelgan de ella con orden propio.
model TechCategory {
  id        String     @id @default(cuid())
  name      String
  position  Int        @default(0)
  items     TechItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([position])
  @@map("tech_categories")
}

/// Tecnología individual dentro de una categoría (Next.js, Docker, Proxmox, ...).
model TechItem {
  id         String       @id @default(cuid())
  name       String
  position   Int          @default(0)
  categoryId String       @map("category_id")
  category   TechCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([categoryId, position])
  @@map("tech_items")
}
