generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  TRASHED
}

// Taxonomía de primer nivel del blog. Son 4 y son fijas: viven en la BD como
// enum para que `posts.main_category` no pueda contener basura y para poder
// filtrar el listado por índice sin join. Si algún día necesitas crearlas desde
// el CMS, esto tiene que pasar a tabla.
enum MainCategory {
  SOFTWARE_DEV   // Software & Dev
  INFRA_HOMELAB  // Infra & Homelab
  IT_HARDWARE    // IT & Hardware
  IA_TECH        // IA & Tech
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  IN_PROGRESS
}

enum VideoType {
  YOUTUBE
  YOUTUBE_SHORT
  TIKTOK
  TWITTER
  VIMEO
  ODYSEE
  GENERIC
}

enum CourseStatus {
  COMING_SOON
  AVAILABLE
  IN_PROGRESS
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExperimentStatus {
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  ABANDONED
}

enum TimelineEventType {
  EDUCATION
  WORK
  PROJECT
  ACHIEVEMENT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  avatar       String?
  bio          String?
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  posts        Post[]
  comments     Comment[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  action String
  resource String
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([action, resource, roleId])
  @@map("permissions")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverImage  String?    @map("cover_image")
  videoUrl    String?    @map("video_url")
  videoType   VideoType? @map("video_type")
  externalLinkLabel String? @map("external_link_label")
  externalLinkUrl   String? @map("external_link_url")
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?  @map("published_at")
  readingTime Int        @default(0) @map("reading_time")
  authorId    String     @map("author_id")
  author      User       @relation(fields: [authorId], references: [id])
  // Taxonomía de dos niveles.
  // `mainCategory` es obligatorio. `subCategoryId` es opcional, pero si viene tiene
  // que pertenecer a `mainCategory`: la FK compuesta de abajo lo garantiza en el
  // motor, no en el código. Si subCategoryId es NULL, Postgres no evalúa la FK.
  mainCategory  MainCategory @map("main_category")
  subCategoryId String?      @map("sub_category_id")
  subCategory   Subcategory? @relation(fields: [subCategoryId, mainCategory], references: [id, mainCategory], onDelete: Restrict)

  // LEGACY: la clasificación plana anterior, retenida durante la migración. Ya no
  // la expone la API y se elimina cuando la taxonomía nueva esté validada en prod.
  categoryId  String?    @map("category_id")
  category    Category?  @relation(fields: [categoryId], references: [id])
  tags        PostTag[]
  comments    Comment[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([mainCategory, subCategoryId])
  @@map("posts")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  posts       Post[]

  @@map("categories")
}

/// Subcategoría de segundo nivel. Pertenece SIEMPRE a una categoría principal
/// concreta: (mainCategory, slug) es único, y la FK compuesta desde Post impide
/// guardar un post cuya subcategoría no sea de su propia categoría principal.
model Subcategory {
  id           String       @id @default(cuid())
  slug         String
  name         String
  description  String?
  mainCategory MainCategory @map("main_category")
  position     Int          @default(0)
  posts        Post[]

  @@unique([mainCategory, slug])
  /// Necesario para que Post pueda referenciar (id, mainCategory) como FK compuesta.
  @@unique([id, mainCategory])
  @@index([mainCategory, position])
  @@map("subcategories")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description       String
  longDescription   String?       @map("long_description")
  technologies      String[]
  category          String?
  tags              String[]
  projectYear       Int?          @map("project_year")
  repository        String?
  demo              String?
  documentation     String?
  status            ProjectStatus @default(IN_PROGRESS)
  featured          Boolean       @default(false)
  coverImage        String?       @map("cover_image")
  problem           String?
  solution          String?
  role              String?
  architecture      String?
  architectureImage String?       @map("architecture_image")
  technicalDecisions Json         @default("[]") @map("technical_decisions")
  challenges        Json         @default("[]")
  results           String?
  learnings         String?
  gallery           String[]
  publishedAt       DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model Video {
  id          String    @id @default(cuid())
  title       String
  url         String
  videoType   VideoType @default(YOUTUBE)
  thumbnail   String?
  description String?
  publishedAt DateTime  @default(now()) @map("published_at")
  isShort     Boolean   @default(false) @map("is_short")
  featured    Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([featured, position])
  @@map("videos")
}

model Course {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String
  level        CourseDifficulty @default(BEGINNER)
  duration     String
  lessonsCount Int              @default(0) @map("lessons_count")
  status       CourseStatus @default(COMING_SOON)
  coverImage   String?          @map("cover_image")
  position     Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, position])
  @@map("courses")
}

model LabExperiment {
  id              String           @id @default(cuid())
  title           String           @default("")
  slug            String           @unique
  description     String
  objective       String?
  hypothesis      String?
  environment     String?
  procedure       String?
  status          ExperimentStatus @default(IN_PROGRESS)
  result          String?
  conclusion      String?
  stack           String[]
  tags            String[]
  coverImage      String?          @map("cover_image")
  gallery         String[]
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  relatedPostId   String?          @map("related_post_id")
  relatedProjectId String?         @map("related_project_id")
  // Legacy columns are retained during the data migration and are no longer exposed by the API.
  name            String?
  icon            String?
  url             String?
  position        Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("lab_services")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String   @map("mime_type")
  size      Int
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?  @map("author_id")
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model TimelineEvent {
  id          String           @id @default(cuid())
  year        String
  title       String
  description String
  type        TimelineEventType @default(PROJECT)
  position    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([position, createdAt])
  @@map("timeline_events")
}
