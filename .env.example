# Database
POSTGRES_USER=kevincarmen
POSTGRES_PASSWORD=cambiar_en_el_entorno
POSTGRES_DB=kevincarmen
DATABASE_URL=postgresql://kevincarmen:cambiar_en_el_entorno@localhost:5432/kevincarmen

# Redis
REDIS_URL=redis://localhost:6379

# API
JWT_SECRET=change-me-in-production-use-strong-secret
ALLOWED_ORIGINS=http://localhost:3000,https://kevincarmen.xyz
PUBLIC_SITE_HOSTS=kevincarmen.xyz,www.kevincarmen.xyz
PORT=4001

# Web
# URL de la API para el frontend. Usar ruta relativa (/api/v1) en producción
# para que nginx/cloudflare proxifique al API (mismo origen).
# En desarrollo local funciona igual gracias a los rewrites de next.config.js.
NEXT_PUBLIC_API_URL=/api/v1
# Solo desarrollo local: destino del rewrite de Next.js hacia NestJS.
API_PROXY_TARGET=http://localhost:4001
# URL interna servidor-servidor usada por Next.js en Server Components.
API_INTERNAL_URL=http://localhost:4001/api/v1
# Desarrollo local; Docker sobrescribe este valor con /uploads.
UPLOAD_DIR=../web/public/uploads/posts
