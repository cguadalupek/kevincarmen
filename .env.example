# Database
# Cambia estos valores en tu .env real: es el unico que se monta en los contenedores.
POSTGRES_USER=kevincarmen
POSTGRES_PASSWORD=cambiar_en_el_entorno
POSTGRES_DB=kevincarmen
DATABASE_URL=postgresql://kevincarmen:cambiar_en_el_entorno@localhost:5432/kevincarmen

# Redis
REDIS_URL=redis://localhost:6379

# API
JWT_SECRET=change-me-in-production-use-strong-secret
ALLOWED_ORIGINS=http://localhost:3000,https://kevincarmen.xyz
PUBLIC_SITE_HOSTS=kevincarmen.xyz,www.kevincarmen.xyz
PORT=4001

# Web
# URL de la API para el frontend. Usar ruta relativa (/api/v1) en producción
# para que nginx/cloudflare proxifique al API (mismo origen).
# En desarrollo local funciona igual gracias a los rewrites de next.config.js.
NEXT_PUBLIC_API_URL=/api/v1
# Solo desarrollo local: destino del rewrite de Next.js hacia NestJS.
API_PROXY_TARGET=http://localhost:4001
# URL interna servidor-servidor usada por Next.js en Server Components.
API_INTERNAL_URL=http://localhost:4001/api/v1
# Secreto compartido del endpoint interno POST /api/revalidate (header
# `x-revalidate-secret`). Docker lo pasa también como NEXT_PUBLIC_REVALIDATE_SECRET
# en el build arg del servicio web.
REVALIDATE_SECRET=change-me-in-production-use-strong-secret
# Docker: activa output: 'standalone' en el build de Next (lo fija el Dockerfile).
# DOCKER_BUILD=true
# Desarrollo local; Docker sobrescribe este valor con /uploads.
UPLOAD_DIR=../web/public/uploads/posts

# Telemetría por SSH (solo servidor, la usa src/lib/telemetry/ssh-telemetry.ts).
# NUNCA pongas estas credenciales en el código ni las commitees: van en el .env real
# del servidor y docker-compose.yml las pasa al contenedor `web`.
# Sin SSH_TELEMETRY_HOST/USER/PASSWORD la telemetría queda desactivada y no abre sockets.
# SSH_TELEMETRY_HOST=192.168.1.108
# SSH_TELEMETRY_PORT=22
# SSH_TELEMETRY_USER=root
# SSH_TELEMETRY_PASSWORD=cambiar_en_el_entorno
# SSH_TELEMETRY_ENABLED=true
# Fichero de log remoto (se crea si no existe) y límites de la sesión.
# SSH_TELEMETRY_LOG=/var/log/kevin-telemetry/likes.log
# SSH_TELEMETRY_CONNECT_TIMEOUT_MS=4000
# SSH_TELEMETRY_COMMAND_TIMEOUT_MS=3000
# SSH_TELEMETRY_THROTTLE_MS=15000
