{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "REVALIDATE_SECRET",
        "ALLOWED_ORIGINS",
        "PUBLIC_SITE_HOSTS",
        "PORT",
        "UPLOAD_DIR",
        "API_INTERNAL_URL",
        "API_PROXY_TARGET",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
